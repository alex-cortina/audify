{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audify",
  "version": "0.1.0",
  "identifier": "com.audify.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Audify",
        "width": 1280,
        "height": 760,
        "minWidth": 800,
        "minHeight": 480,
        "backgroundColor": "#121418"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "fileAssociations": [
      {
        "ext": ["wav", "mp3", "ogg", "flac", "m4a", "aiff"],
        "name": "Audio File",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
